<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RailwayQuickBook.Desktop.MainWindow"
        Title="Railway Quick Book"
        Width="540" Height="700"
        MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        FontFamily="avares://RailwayQuickBook/Assets/Fonts/Figtree#Figtree Light, Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource RqbBackdrop}">
  <ScrollViewer>
    <StackPanel Margin="26,24,26,18" Spacing="12">
      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                Background="{DynamicResource RqbAccent}" VerticalAlignment="Center">
          <TextBlock Text="R" Foreground="{DynamicResource RqbAccentForeground}"
                     FontSize="20" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="14,0,0,0">
          <TextBlock Text="Railway Quick Book" FontSize="20" FontWeight="SemiBold" LetterSpacing="-0.3" />
          <TextBlock Text="Set up once, then open the railway site in a click."
                     FontSize="13.5" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" x:Name="ThemeToggleBtn" Classes="secondary" Content="◐ Auto"
                VerticalAlignment="Top" ToolTip.Tip="Switch light / dark mode" />
      </Grid>

      <!-- Progress -->
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,6,*,6,*">
          <Border Grid.Column="0" x:Name="Prog1" Classes="prog" />
          <Border Grid.Column="2" x:Name="Prog2" Classes="prog" />
          <Border Grid.Column="4" x:Name="Prog3" Classes="prog" />
        </Grid>
        <TextBlock x:Name="ProgLabel" Text="Step 2 of 3" FontSize="12.5" FontWeight="Medium" Opacity="0.7" />
      </StackPanel>

      <!-- One bordered step list -->
      <Border Classes="card">
        <StackPanel Spacing="0">
          <!-- Step 1 -->
          <Grid ColumnDefinitions="Auto,*" Margin="16,15,16,15">
            <Border x:Name="Cir1" Classes="stepcircle" VerticalAlignment="Top">
              <TextBlock x:Name="Num1" Text="1" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="Title1" Text="Browser" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="LinkChange" Classes="link" Content="Change"
                        VerticalAlignment="Center" IsVisible="False" />
              </Grid>
              <TextBlock x:Name="Sum1" Text="…" FontSize="13" Opacity="0.7" />
            </StackPanel>
          </Grid>
          <StackPanel x:Name="Step1Body" Margin="56,0,16,18" Spacing="8" IsVisible="False">
            <WrapPanel x:Name="BrowserChips" Orientation="Horizontal" />
            <Button x:Name="RefreshBrowsersBtn" Classes="link" Content="Refresh browser list" />
            <Border x:Name="ErrorBox" Classes="errorbox" IsVisible="False">
              <TextBlock Text="No Chrome or Brave found. Install one, then refresh the list."
                         FontSize="13.5" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
          <Separator Margin="0" />

          <!-- Step 2 -->
          <Grid ColumnDefinitions="Auto,*" Margin="16,15,16,15">
            <Border x:Name="Cir2" Classes="stepcircle" VerticalAlignment="Top">
              <TextBlock x:Name="Num2" Text="2" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="Title2" Text="Load the extension" FontSize="15"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="LinkReview" Classes="link" Content="Review"
                        VerticalAlignment="Center" IsVisible="False" />
              </Grid>
              <TextBlock x:Name="Sum2" Text="…" FontSize="13" Opacity="0.7" />
            </StackPanel>
          </Grid>
          <StackPanel x:Name="Step2Body" Margin="56,0,16,18" Spacing="8" IsVisible="False">
            <Button x:Name="OpenBrowserBtn" Classes="primary" Content="Open Browser"
                    HorizontalAlignment="Left" />
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="The address below is already copied. Press " FontSize="13"
                         Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Border Classes="keycap"><TextBlock Text="Ctrl" /></Border>
              <TextBlock Text="+" FontSize="13" VerticalAlignment="Center" Margin="4,0" />
              <Border Classes="keycap"><TextBlock Text="V" /></Border>
              <TextBlock Text=" in the address bar, then " FontSize="13" Opacity="0.7"
                         VerticalAlignment="Center" />
              <Border Classes="keycap"><TextBlock Text="Enter" /></Border>
              <TextBlock Text=". Browsers block apps from opening this page for you." FontSize="13"
                         Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,Auto">
              <Border Grid.Column="0" Background="{DynamicResource RqbBackdrop}"
                      BorderBrush="{DynamicResource RqbBorder}" BorderThickness="1"
                      CornerRadius="6" Padding="10,8" VerticalAlignment="Center">
                <TextBlock x:Name="ExtUrlBox" Text="chrome://extensions" FontSize="12.5" FontWeight="Medium"
                           FontFamily="avares://RailwayQuickBook/Assets/Fonts/JetBrainsMono#JetBrains Mono, Cascadia Mono, Consolas"
                           TextTrimming="PrefixCharacterEllipsis" />
              </Border>
              <Button Grid.Column="1" x:Name="CopyUrlBtn" Classes="secondary" Content="Copy"
                      Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="1. Switch on Developer mode, top-right." FontSize="13.5" TextWrapping="Wrap" />
            <TextBlock Text="2. Click Load unpacked and pick the folder below." FontSize="13.5" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Border Grid.Column="0" Background="{DynamicResource RqbBackdrop}"
                      BorderBrush="{DynamicResource RqbBorder}" BorderThickness="1"
                      CornerRadius="6" Padding="10,8" VerticalAlignment="Center">
                <TextBlock x:Name="ExtensionDirText" Text="" FontSize="12.5" FontWeight="Medium"
                           FontFamily="avares://RailwayQuickBook/Assets/Fonts/JetBrainsMono#JetBrains Mono, Cascadia Mono, Consolas"
                           TextTrimming="PrefixCharacterEllipsis" TextWrapping="NoWrap" />
              </Border>
              <Button Grid.Column="1" x:Name="OpenExtensionFolderBtn" Classes="secondary" Content="Open"
                      Margin="8,0,0,0" VerticalAlignment="Center" />
              <Button Grid.Column="2" x:Name="CopyExtensionPathBtn" Classes="secondary" Content="Copy"
                      Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Tip: you can also drag that folder onto the extensions page."
                       FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
            <Separator Margin="0,4" />
            <Grid ColumnDefinitions="Auto,*">
              <CheckBox Grid.Column="0" x:Name="ExtensionLoadedSwitch" VerticalAlignment="Top"
                        Margin="0,2,12,0" />
              <StackPanel Grid.Column="1" Spacing="0">
                <TextBlock Text="I've loaded the extension" FontSize="14" FontWeight="Medium" />
                <TextBlock Text="Tick this after Load unpacked. The app never touches your browser itself."
                           FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </StackPanel>
          <Separator Margin="0" />

          <!-- Step 3 -->
          <Grid ColumnDefinitions="Auto,*" Margin="16,15,16,15">
            <Border x:Name="Cir3" Classes="stepcircle" VerticalAlignment="Top">
              <TextBlock x:Name="Num3" Text="3" />
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="0">
              <TextBlock x:Name="Title3" Text="Open the railway site" FontSize="15"
                         FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock x:Name="Sum3" Text="Finish setup first" FontSize="13" Opacity="0.7" />
            </StackPanel>
          </Grid>
          <StackPanel x:Name="Step3Body" Margin="56,0,16,18" Spacing="8" IsVisible="False">
            <Button x:Name="OpenSiteBtn" Classes="primary" Content="Open Railway Website →"
                    HorizontalAlignment="Left" />
            <TextBlock Text="Log in manually, then use the extension. Passwords, OTPs and payments are never read."
                       FontSize="13" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Status line -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border x:Name="StatusDot" Classes="sdot amber" />
        <TextBlock x:Name="StatusText" Text="…" FontSize="13" Opacity="0.7" VerticalAlignment="Center" />
      </StackPanel>

      <!-- Footer -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button x:Name="UninstallDataBtn" Classes="ghostdanger" Content="Remove local data…" />
          <Button x:Name="DetailsBtn" Classes="link" Content="Details" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="ExitBtn" Classes="secondary" Content="Exit" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
