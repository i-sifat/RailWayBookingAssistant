<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RailwayQuickBook</AssemblyName>
    <RootNamespace>RailwayQuickBook.Desktop</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Keep in step with the release tag being cut; see ci/README.md.
         Must stay a numeric major.minor.patch - build metadata such as
         "+b1" is not valid here. -->
    <Version>0.0.1</Version>
    <!-- Self-contained single-file is enabled at publish time.
         See Properties/PublishProfiles and desktop/README.md. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <!-- REQUIRED for the published single file to actually run.

         With PublishSingleFile=true, the .NET SDK excludes every NuGet asset
         of type "native" from the bundle unless this is true, and drops those
         files next to the exe instead (see _BundleExcludedFiles in
         Microsoft.NET.Publish.targets). Avalonia pulls in libSkiaSharp,
         libHarfBuzzSharp and av_libglesv2 that way, so the "single" file was
         not self-contained: the release shipped only the exe, and the app died
         silently at UsePlatformDetect() trying to load Skia.

         Do NOT switch this to IncludeAllContentForSelfExtract - that changes
         AppContext.BaseDirectory to the temp extraction directory, which would
         break Paths.ProjectRoot and the extension-folder detection. This
         setting leaves BaseDirectory as the exe's own directory. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
  </ItemGroup>

  <!-- The built browser extension ships INSIDE the exe as embedded resources
       (logical names "extension/..."), so releases carry no separate folder
       and the app can lay out a clean copy on demand (see
       Services/ExtensionBundle.cs). CI runs 'npm run build' BEFORE
       'dotnet publish' (see release.yml) so dist/ exists at this point.
       A missing dist/ locally just yields an empty bundle, not an error. -->
  <ItemGroup>
    <EmbeddedResource Include="..\dist\**\*" Exclude="..\dist\**\*.d.ts;..\dist\**\*.map" LogicalName="extension/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Fail loudly on CI when dist/ was not built first: without it the exe
       would ship an empty bundle and Step 3 would silently find nothing. -->
  <Target Name="RequireExtensionDist" BeforeTargets="Build" Condition="'$(CI)' == 'true'">
    <Error Condition="!Exists('..\dist\manifest.json')" Text="Extension dist/ was not built before dotnet publish. CI must run 'npm run build' first (see release.yml)." />
  </Target>

</Project>
