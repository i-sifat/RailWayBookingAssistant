<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RailwayQuickBook.Desktop.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RqbBackdrop">#FAF9F5</SolidColorBrush>
          <SolidColorBrush x:Key="RqbCard">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="RqbField">#FAF9F5</SolidColorBrush>
          <SolidColorBrush x:Key="RqbBorder">#E4E1D6</SolidColorBrush>
          <SolidColorBrush x:Key="RqbDimText">#66706A</SolidColorBrush>
          <SolidColorBrush x:Key="RqbAccent">#0F5B39</SolidColorBrush>
          <SolidColorBrush x:Key="RqbAccentForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="RqbOk">#0F5B39</SolidColorBrush>
          <SolidColorBrush x:Key="RqbOkSoft">#E7F0EA</SolidColorBrush>
          <SolidColorBrush x:Key="RqbWarn">#B5772A</SolidColorBrush>
          <SolidColorBrush x:Key="RqbWarnSoft">#F5EAD9</SolidColorBrush>
          <SolidColorBrush x:Key="RqbBad">#A23B2E</SolidColorBrush>
          <SolidColorBrush x:Key="RqbBadSoft">#F6E4DF</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RqbBackdrop">#111713</SolidColorBrush>
          <SolidColorBrush x:Key="RqbCard">#171E19</SolidColorBrush>
          <SolidColorBrush x:Key="RqbField">#111713</SolidColorBrush>
          <SolidColorBrush x:Key="RqbBorder">#2B342E</SolidColorBrush>
          <SolidColorBrush x:Key="RqbDimText">#9AA69C</SolidColorBrush>
          <SolidColorBrush x:Key="RqbAccent">#4CB081</SolidColorBrush>
          <SolidColorBrush x:Key="RqbAccentForeground">#0B120E</SolidColorBrush>
          <SolidColorBrush x:Key="RqbOk">#4CB081</SolidColorBrush>
          <SolidColorBrush x:Key="RqbOkSoft">#1C2B22</SolidColorBrush>
          <SolidColorBrush x:Key="RqbWarn">#D69A55</SolidColorBrush>
          <SolidColorBrush x:Key="RqbWarnSoft">#2E2416</SolidColorBrush>
          <SolidColorBrush x:Key="RqbBad">#DE8672</SolidColorBrush>
          <SolidColorBrush x:Key="RqbBadSoft">#2E1D19</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource RqbCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RqbBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,3"/>
    </Style>
    <Style Selector="Border.pill.ok">
      <Setter Property="Background" Value="{DynamicResource RqbOkSoft}"/>
    </Style>
    <Style Selector="Border.pill.ok TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RqbOk}"/>
    </Style>
    <Style Selector="Border.pill.warn">
      <Setter Property="Background" Value="{DynamicResource RqbWarnSoft}"/>
    </Style>
    <Style Selector="Border.pill.warn TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RqbWarn}"/>
    </Style>
    <Style Selector="Border.pill.bad">
      <Setter Property="Background" Value="{DynamicResource RqbBadSoft}"/>
    </Style>
    <Style Selector="Border.pill.bad TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RqbBad}"/>
    </Style>
    <Style Selector="ToggleButton.chip">
      <Setter Property="Background" Value="{DynamicResource RqbField}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RqbBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="ToggleButton.chip:checked">
      <Setter Property="Background" Value="{DynamicResource RqbAccentSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RqbAccent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource RqbAccent}"/>
      <Setter Property="Foreground" Value="{DynamicResource RqbAccentForeground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.inline">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource RqbAccent}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.ghostdanger">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource RqbDimText}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.ghostdanger:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource RqbBad}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.stepcircle">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RqbAccent}"/>
    </Style>
    <Style Selector="Border.stepcircle TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RqbAccent}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.keycap">
      <Setter Property="BorderBrush" Value="{DynamicResource RqbBorder}"/>
      <Setter Property="BorderThickness" Value="1,1,1,2"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="Background" Value="{DynamicResource RqbBackdrop}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.keycap TextBlock">
      <Setter Property="FontFamily" Value="avares://RailwayQuickBook/Assets/Fonts/JetBrainsMono#JetBrains Mono, Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{DynamicResource RqbCard}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RqbBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Border.errorbox">
      <Setter Property="Background" Value="{DynamicResource RqbBadSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RqbBad}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="Border.sdot">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Height" Value="8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.sdot.amber">
      <Setter Property="Background" Value="{DynamicResource RqbWarn}"/>
    </Style>
    <Style Selector="Border.sdot.ready">
      <Setter Property="Background" Value="{DynamicResource RqbAccent}"/>
    </Style>
    <Style Selector="Border.sdot.bad">
      <Setter Property="Background" Value="{DynamicResource RqbBad}"/>
    </Style>
    <Style Selector="Border.prog">
      <Setter Property="Height" Value="4"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Background" Value="{DynamicResource RqbBorder}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.prog.done">
      <Setter Property="Background" Value="{DynamicResource RqbAccent}"/>
    </Style>
    <Style Selector="Border.stepcircle.locked">
      <Setter Property="BorderBrush" Value="{DynamicResource RqbDimText}"/>
    </Style>
    <Style Selector="Border.stepcircle.locked TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RqbDimText}"/>
    </Style>
    <Style Selector="Border.stepcircle.done">
      <Setter Property="Background" Value="{DynamicResource RqbAccent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RqbAccent}"/>
    </Style>
    <Style Selector="Border.stepcircle.done TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RqbAccentForeground}"/>
    </Style>
    <Style Selector="TextBlock.steptitle.locked">
      <Setter Property="Foreground" Value="{DynamicResource RqbDimText}"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
  </Application.Styles>
</Application>
