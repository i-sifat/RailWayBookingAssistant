{
  "name": "railway-booking-assistant",
  "version": "1.0.0",
  "description": "Local-first assistant that speeds up form-filling on a railway site you are already logged into. Stops on CAPTCHA/OTP/payment.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && npm run bundle && npm run copy:static",
    "bundle": "esbuild src/content/content-script.ts --bundle --format=iife --target=chrome120 --outfile=dist/content/content-script.js --log-level=warning && esbuild src/background/service-worker.ts --bundle --format=esm --target=chrome120 --outfile=dist/background/service-worker.js --log-level=warning",
    "copy:static": "node scripts/copy-static.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/chrome": "^0.0.263",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
